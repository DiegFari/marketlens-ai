# Caddy obtains and renews a free Let's Encrypt certificate for SITE_ADDRESS
# automatically, redirects http -> https, and proxies to the Streamlit UI
# (including its websocket).
{$SITE_ADDRESS} {
	encode gzip
	reverse_proxy ui:8501
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
