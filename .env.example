# Copy to .env and fill in the three keys in "Required". Never commit .env.
# Blank values count as "not set". In the cloud, set these as the platform's secrets.

# ================================ Required =====================================
# All three are free and need no credit card.
FMP_API_KEY=                      # https://site.financialmodelingprep.com/developer/docs
NEWSAPI_API_KEY=                  # https://newsapi.org/register
GROQ_API_KEY=                     # https://console.groq.com/keys

# ---- Language model ------------------------------------------------------------
LLM_PROVIDER=groq                 # groq | ollama | azure_openai
# LLM_STRUCTURED_OUTPUT=          # json_schema | function_calling (default depends on provider)
LLM_STRUCTURED_OUTPUT_FALLBACK=true # if structured output fails, retry once with the other method
LLM_MAX_RETRIES=3                 # SDK retries on 429/5xx (honours Retry-After)
LLM_REQUEST_TIMEOUT_SECONDS=60
# LLM_TEMPERATURE=0.2             # leave unset for reasoning models (they reject it)

GROQ_MODEL=openai/gpt-oss-120b    # any Groq chat model with tool use

OLLAMA_MODEL=qwen2.5:3b           # local; run `ollama pull qwen2.5:3b` first
OLLAMA_BASE_URL=http://localhost:11434/v1

AZURE_OPENAI_ENDPOINT=            # https://<resource>.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21   # structured outputs need 2024-08-01-preview or later
AZURE_OPENAI_CHAT_DEPLOYMENT=     # the deployment name chosen in Azure AI Foundry

# ---- Agent workflow -------------------------------------------------------------
AGENT_WORKFLOW_TIMEOUT_SECONDS=120
AGENT_MAX_SUPERVISOR_TURNS=8
AGENT_NEWS_LOOKBACK_DAYS=7
AGENT_NEWS_ARTICLES_FOR_ANALYSIS=30
AGENT_NEWS_MAX_TOOL_ROUNDS=3
AGENT_DEBUG=false                 # logs prompts and model outputs at DEBUG; never in prod

# ---- Application -----------------------------------------------------------
ENVIRONMENT=local                 # local | dev | staging | prod
DEBUG=false
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=console                # console (local) | json (cloud)
CORS_ORIGINS=http://localhost:8501

# ---- Data providers (advanced) ---------------------------------------------------
FMP_BASE_URL=https://financialmodelingprep.com/stable
FMP_REQUESTS_PER_MINUTE=300       # client-side ceiling; daily plan quota is enforced by FMP
NEWSAPI_BASE_URL=https://newsapi.org/v2
NEWSAPI_REQUESTS_PER_MINUTE=30
NEWSAPI_EXCLUDE_DOMAINS=pypi.org,rlsbb.cc   # listings that match company names but carry no news
NEWSAPI_MIN_HEADLINE_ARTICLES=10           # below this, widen search from headlines to descriptions
DATA_PROVIDER_TIMEOUT_SECONDS=15
DATA_PROVIDER_MAX_RETRIES=3       # transient failures only (timeouts, 5xx, short Retry-After)
DATA_PROVIDER_CACHE_ENABLED=true  # in-process TTL cache; saves free-tier quota

# ---- Azure Blob Storage (future phase) --------------------------------------------
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_REPORTS_CONTAINER=reports

# ---- Streamlit UI -------------------------------------------------------------
UI_API_BASE_URL=http://localhost:8000
UI_REQUEST_TIMEOUT_SECONDS=180
